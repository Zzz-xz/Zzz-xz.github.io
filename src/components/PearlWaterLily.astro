<style>
    /**
     * @brief 采用主叶承托、辅叶退后和花心上提的非对称簇状构图。
     * @note 收紧后的取景框只改变视觉层次，不参与页面内容排版。
     */
    .pearl-water-lily {
        --lily-glint-opacity: 0.28;
        --lily-rim-opacity: 0.15;
        position: absolute;
        inset-block-start: auto;
        inset-block-end: var(--lily-inset-block-compact);
        inset-inline-start: auto;
        inset-inline-end: max(
            var(--space-2xs),
            calc(var(--page-gutter-end) - var(--lily-edge-compensation-compact))
        );
        z-index: var(--layer-atmosphere);
        inline-size: var(--lily-size-compact);
        aspect-ratio: 48 / 41;
        opacity: 0.86;
        pointer-events: none;
        user-select: none;
        transform: none;
        transition: opacity var(--dur-lily-settle) var(--ease-out);
        contain: layout style;
    }

    .pearl-water-lily.is-near {
        opacity: 0.95;
    }

    .pearl-water-lily__motion,
    .pearl-water-lily__canvas {
        display: block;
        inline-size: 100%;
        block-size: 100%;
    }

    .pearl-water-lily__motion {
        transform-box: fill-box;
        transform-origin: 56.1% 45%;
    }

    .pearl-water-lily__canvas {
        overflow: visible;
    }

    .lily-layer {
        --layer-x: 0px;
        --layer-y: 0px;
        --layer-rotate: 0deg;
        transform: translate3d(var(--layer-x), var(--layer-y), 0) rotate(var(--layer-rotate));
        transform-box: fill-box;
        transform-origin: center;
        transition: transform var(--dur-lily-settle) var(--ease-out);
    }

    .lily-stop--pearl {
        stop-color: var(--color-lily-pearl);
    }

    .lily-stop--shell {
        stop-color: var(--color-lily-shell);
    }

    .lily-stop--mist {
        stop-color: var(--color-lily-mist);
    }

    .lily-stop--sage-soft {
        stop-color: var(--color-lily-sage-soft);
    }

    .lily-stop--sage {
        stop-color: var(--color-lily-sage);
    }

    .lily-stop--gold-light {
        stop-color: var(--color-lily-gold-light);
    }

    .lily-stop--gold-fade {
        stop-color: var(--color-lily-gold);
        stop-opacity: 0.16;
    }

    .lily-stop--gold-deep {
        stop-color: var(--color-lily-gold-deep);
    }

    .lily-contact-shadow {
        fill: var(--color-lily-shadow);
        fill-opacity: 0.1;
    }

    .lily-pad {
        fill: url('#lily-pad-sage');
        fill-opacity: 0.58;
        stroke: var(--color-lily-line);
        stroke-width: 0.92;
        stroke-opacity: 0.72;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
    }

    .lily-pad--right {
        fill-opacity: 0.38;
        stroke-opacity: 0.44;
    }

    .lily-pad-veins path {
        fill: none;
        stroke: var(--color-lily-depth);
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }

    .lily-pad-veins path {
        stroke-width: 0.78;
        opacity: 0.18;
    }

    /**
     * @brief 将水纹置于独立坐标系并缩短弧长，避免非等比缩放形成荷叶残余轮廓。
     */
    .lily-waterline {
        fill: none;
        stroke: var(--color-lily-waterline);
        stroke-width: 0.58;
        stroke-linecap: round;
        opacity: 0.16;
        vector-effect: non-scaling-stroke;
    }

    .lily-waterline--right {
        opacity: 0.12;
    }

    .lily-dew ellipse {
        fill: var(--color-lily-glint);
        fill-opacity: 0.56;
        stroke: var(--color-lily-line);
        stroke-width: 0.75;
        vector-effect: non-scaling-stroke;
    }

    .lily-dew path {
        fill: none;
        stroke: var(--color-lily-glint);
        stroke-width: 1.5;
        stroke-linecap: round;
        opacity: 0.86;
        vector-effect: non-scaling-stroke;
    }

    .lily-fold {
        transform-box: fill-box;
        transform-origin: 50% 58%;
    }

    /**
     * @brief 统一花喉、雄蕊与花粉簇的回弹坐标系，使花心始终贴合内层花瓣。
