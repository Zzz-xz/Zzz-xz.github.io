---
/**
 * @file collection.astro
 * @brief 构建资源收录导航和本地搜索页面。
 */

import { getCollection } from 'astro:content';
import CollectionFooter from '../components/CollectionFooter.astro';
import ResourceDirectory from '../components/ResourceDirectory.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import categoryFile from '../data/categories.json';
import { buildCatalog } from '../lib/catalog';

const resourceEntries = await getCollection('resources');
const categories = buildCatalog(categoryFile.categories, resourceEntries);
---

<SiteLayout
    title="Collection · Zzz-xz"
    description="Zzz-xz 整理的开源软件与实用资源导航"
    canonicalPath="/collection/"
    bodyClass="collection-page"
    includeCollectionStyles
>
    <div class="page-shell">
        <SiteHeader currentPage="collection" />

        <main class="collection-main" id="content">
            <section class="collection-intro" aria-labelledby="collectionTitle">
                <h1 id="collectionTitle">Collection</h1>
                <p class="collection-intro__copy">一些值得再次打开的开源软件、项目与实用资源。</p>
                <p class="collection-intro__notice">
                    本页仅提供在新窗口打开的站外链接，不托管目标内容；收录不代表授权或背书。
                    <a class="inline-link" href="#disclaimer">查看外链与权利声明</a>
                </p>
            </section>

            <ResourceDirectory categories={categories} />

            <section class="disclaimer" id="disclaimer" aria-labelledby="disclaimerTitle">
                <h2 id="disclaimerTitle">外链与权利声明</h2>
                <div class="disclaimer__body">
                    <p>本页是个人维护的站外导航。所有资源条目均链接至由第三方独立运营的网站，点击后将在新窗口离开本站。本站仅整理资源名称、简要介绍和链接，不托管、上传、复制、缓存、镜像、在线播放或分发目标网站的文件与内容，也不提供破解、绕过付费或规避技术保护措施的服务。</p>
                    <p>收录链接不表示本站与目标网站或其权利人存在合作、代理、授权、推荐、担保或背书关系。网站名称、商标、作品及其他内容的权利归相应权利人所有；除非另有明确说明，本站未获得其复制、传播、改编或商业使用授权。</p>
                    <p>“项目官网”“官方仓库”等来源标识仅说明链接指向目标项目自行公布的入口；“第三方网站”表示本站未核实其与相关内容权利人的授权关系。任何来源标识均不构成对目标网站全部内容的版权状态、合法性、准确性、可用性或安全性的确认。外部网站可能随时变更内容、地址、服务条款和隐私政策，本站无法控制或持续审查。</p>
                    <p>访问者应在使用外部网站前自行核实内容来源、许可范围、地区限制及适用规则，并遵守相关法律和目标网站条款。请勿利用本页链接获取、复制、传播或使用无权访问的内容，亦不得实施侵犯著作权、商标权、隐私权或其他合法权益的行为。</p>
                    <p>如您是权利人或其授权代表，认为某项链接涉及侵权、错误归属或其他不适宜情形，请通过 <a class="inline-link" href="mailto:imzou.ht@outlook.com?subject=Collection%20权利通知与链接反馈">权利通知邮箱</a> 提供您的身份与联系方式、权属或授权证明、具体收录名称和链接，以及请求处理的理由。收到信息完整且可核验的通知后，本站将及时核查，并视情况更正、删除或断开相关链接。</p>
                    <p>在适用法律允许的范围内，本站不对访问或使用外部网站产生的内容风险、服务中断、数据损失或其他损害作保证或承担超出法定范围的责任。本声明不排除或限制依法不得排除或限制的责任。</p>
                </div>
            </section>
        </main>

        <CollectionFooter />
    </div>

    <script>
        import '../scripts/collection.js';
    </script>
</SiteLayout>
