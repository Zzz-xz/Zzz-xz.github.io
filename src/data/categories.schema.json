{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zzz-xz Collection Categories",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "order"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
